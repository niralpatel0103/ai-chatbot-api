# Groq LLM API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Supabase / PostgreSQL Connection String
# Leave commented out to use local SQLite automatically (database.db)
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# JWT Secret Key for user authentication
SECRET_KEY=generate_a_random_secret_key_here

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8000
